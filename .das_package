options gen2
require daslib/daspkg

[export]
def package() {
    package_name("dasDuckDB")
    package_description("DuckDB bindings and SQL LINQ provider for daslang")
    package_author("borisbat")
    package_license("MIT")
    package_source("github.com/borisbat/dasDuckDB")
    package_tag("sql")
    package_tag("database")
    package_tag("duckdb")
}

[export]
def build() {
    cmake_build()
}
